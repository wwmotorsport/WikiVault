{
  "name": "wikivault",
  "productName": "Wikivault",
  "version": "0.22.0",
  "description": "Offline English Wikipedia on your own machine: monthly verified editions, offline search, and answers from a local model.",
  "author": "wwmotorsport",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "node scripts/make-notices.js && node scripts/fetch-java.js && electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "notices": "node scripts/make-notices.js",
    "vendor-maps": "node scripts/vendor-maps.js",
    "fetch-java": "node scripts/fetch-java.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "hyparquet": "^1.33.1",
    "hyparquet-writer": "^0.18.0",
    "maplibre-gl": "^5.24.1",
    "pmtiles": "^4.5.0"
  },
  "build": {
    "appId": "local.wikivault.app",
    "productName": "Wikivault",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Wikivault-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt"
    },
    "publish": null,
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "asarUnpack": [
      "assets/routing/**",
      "src/core/**",
      "src/vendor/parquet/**"
    ],
    "extraResources": [
      {
        "from": "build/java-runtime",
        "to": "java"
      }
    ]
  }
}
